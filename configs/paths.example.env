# Copy this file to .env or export these variables in your shell.
# The scripts also keep historical workstation defaults for backward compatibility.

EBTC_PROJECT_ROOT=/path/to/bladder_V2
EBTC_OUTPUT_ROOT=/path/to/experiment_outputs

EBTC_DATA_ROOT=/path/to/EBTC
BIOMEDCLIP_MODEL_DIR=/path/to/biomedclip/model
EBTC_CONCEPT_DIR=/path/to/baseconcept
EBTC_EXPERIMENT_DIR=/path/to/external/experiment_code

EBTC_EMBEDDINGS_DIR=/path/to/official_split_embedding_cache/embeddings
EBTC_BACKUP_EMBEDDINGS_DIR=/path/to/backup_embeddings

# Optional explicit bank paths
EBTC_FILTERED_TOP300_BANK_DIR=/path/to/banks/filtered_top300
EBTC_RETRIEVAL_TOP10_BANK_DIR=/path/to/banks/retrieval_top10_per_class
EBTC_RETRIEVAL_TOP10_DISC_BANK_DIR=/path/to/banks/retrieval_top10_per_class_disc
EBTC_WEIGHTED_SYM10_BANK_DIR=/path/to/banks/bank_weighted_sym10

